# Integration environment. Do not commit real values.
VINSOLUTIONS_BASE_URL=https://integration.api.vinsolutions.com
VINSOLUTIONS_LEADS_PATH=/leadSubmissions
VINSOLUTIONS_API_KEY=
VINSOLUTIONS_DEALER_ID=
VINSOLUTIONS_USER_ID=

# Use the bearer token supplied for testing, or configure the approved OAuth flow.
VINSOLUTIONS_ACCESS_TOKEN=
VINSOLUTIONS_TOKEN_URL=https://authentication.vinsolutions.com/connect/token
VINSOLUTIONS_CLIENT_ID=
VINSOLUTIONS_CLIENT_SECRET=






# The GHL Custom Action must send: X-Connector-Key: <value>
CONNECTOR_API_KEY=

# Version token is CASE-SENSITIVE. Cox's doc example writes 'V3' — that fails
# with ApiVersionUnspecified. Use lowercase 'v3'. Lead Sources is a v1 endpoint.
VINSOLUTIONS_ACCEPT=application/vnd.coxauto.v2+json
VINSOLUTIONS_CONTENT_TYPE=application/vnd.coxauto.v2+json
PORT=8000

# Lead Management API key (duplicate check by phone)
VIN_KEY_LEADMANAGEMENT=
# Digital Showroom API key (lead notes, Set Appointment status)
VIN_KEY_DIGITALSHOWROOM=
# Lead Submissions API key
VIN_KEY_LEADSUBMISSIONS=
# Open leads newer than this many days get new details added instead of a new lead
RECENT_LEAD_DAYS=30
